#!/usr/bin/env bash
# Git pre-push hook: run workspace validation before allowing a push.
# Git-native equivalent of the Devin pre-deploy hook (workspace-push gate).
set -uo pipefail
cd "$(git rev-parse --show-toplevel)"

if [[ -x scripts/workspace-validate.sh ]]; then
  echo "pre-push: running workspace-validate.sh" >&2
  if ! bash scripts/workspace-validate.sh; then
    echo "pre-push: validation failed, push blocked" >&2
    exit 1
  fi
elif [[ -f scripts/workspace-validate.sh ]]; then
  if ! bash scripts/workspace-validate.sh; then
    echo "pre-push: validation failed, push blocked" >&2
    exit 1
  fi
else
  echo "pre-push: no workspace-validate.sh found, skipping" >&2
fi
echo "pre-push: validation passed" >&2
exit 0
