# vm-host/config.bu — Fedora CoreOS VM host: hardened base + Kasm workspace.
#
# Render with vm-host/build.sh (envsubst ${VARS} -> butane --strict).
# Files/units are pulled in via `local:` relative to --files-dir (the vm-host/
# tree root). Three provisioning levels:
#   1_host_level/   -> /etc drop-in configs (applied declaratively by Ignition)
#   2_systemd_level/-> systemd units; security-setup layers rpm-ostree pkgs
#                      on first boot, security-finalize finishes post-reboot
#   3_container_level/ -> /opt/kasm/docker-compose.yaml for the workspace stack
---
variant: fcos
version: 1.5.0

passwd:
  users:
    - name: core
      groups:
        - wheel
      password_hash: ${FCOS_CORE_PASSWORD_HASH}
      ssh_authorized_keys:
        - ${FCOS_SSH_PUBLIC_KEY}

storage:
  directories:
    - path: /etc/ssh/sshd_config.d
      mode: 0700
    - path: /etc/systemd/journald.conf.d
      mode: 0755
    - path: /etc/sysctl.d
      mode: 0755
    - path: /etc/zincati/config.d
      mode: 0755
    - path: /etc/aide
      mode: 0750
    - path: /etc/clamav
      mode: 0750
    - path: /etc/suricata
      mode: 0750
    - path: /etc/firewalld/zones
      mode: 0750
    - path: /var/lib/aide
      mode: 0750
    - path: /var/log/aide
      mode: 0750
    - path: /var/lib/clamav
      mode: 0750
    # NOTE: no user/group here — the suricata account only exists after the
    # rpm-ostree layering in security-setup; security-finalize chowns these.
    - path: /var/lib/suricata/rules
      mode: 0750
    - path: /var/log/suricata
      mode: 0750
    - path: /opt/kasm
      mode: 0755
    - path: /etc/NetworkManager/system-connections
      mode: 0700

  files:
    # Static guest address: FCOS does not auto-configure NICs; without this
    # keyfile the guest boots with no network at all.
    - path: /etc/NetworkManager/system-connections/${FCOS_INTERFACE}.nmconnection
      mode: 0600
      overwrite: true
      contents:
        inline: |
          [connection]
          id=${FCOS_INTERFACE}
          type=ethernet
          interface-name=${FCOS_INTERFACE}
          autoconnect=true
          autoconnect-priority=100

          [ethernet]

          [ipv4]
          method=manual
          address1=${FCOS_LAN_IP}/24,${FCOS_GATEWAY}
          dns=${FCOS_GATEWAY};
          ignore-auto-dns=true

          [ipv6]
          method=disabled

    # ---- 1_host_level -------------------------------------------------
    - path: /etc/ssh/sshd_config.d/00-hardening.conf
      mode: 0600
      overwrite: true
      contents:
        local: 1_host_level/sshd-hardening.conf
    - path: /etc/systemd/journald.conf.d/50-hardening.conf
      mode: 0644
      overwrite: true
      contents:
        local: 1_host_level/journald-hardening.conf
    - path: /etc/sysctl.d/90-kasm.conf
      mode: 0644
      overwrite: true
      contents:
        local: 1_host_level/sysctl-kasm.conf
    - path: /etc/zincati/config.d/10-updates.toml
      mode: 0644
      overwrite: true
      contents:
        local: 1_host_level/zincati-updates.toml
    - path: /etc/aide/aide.conf
      mode: 0640
      overwrite: true
      contents:
        local: 1_host_level/files/aide/aide.conf
    - path: /etc/clamav/freshclam.conf
      mode: 0640
      overwrite: true
      contents:
        local: 1_host_level/files/clamav/freshclam.conf
    # /var/run is a tmpfs still read-only during ignition; tmpfiles creates
    # the runtime dir at boot instead.
    - path: /etc/tmpfiles.d/suricata.conf
      mode: 0644
      overwrite: true
      contents:
        inline: |
          d /run/suricata 0750 suricata suricata -
    - path: /etc/suricata/suricata.yaml
      # 0644: the packaged suricata.service runs as user 'suricata' and must
      # be able to read its config.
      mode: 0644
      overwrite: true
      contents:
        local: 1_host_level/files/suricata/suricata.yaml
    # The packaged default passes "-i eth0", which does not exist on FCOS
    # (iface is ens2+); the interface lives in suricata.yaml af-packet instead.
    - path: /etc/sysconfig/suricata
      mode: 0644
      overwrite: true
      contents:
        inline: |
          OPTIONS="--user suricata"
    # Local rules live in the rule path the config's default-rule-points at,
    # named exactly as its rule-files list expects: local.rules.
    - path: /var/lib/suricata/rules/local.rules
      mode: 0644
      overwrite: true
      contents:
        local: 1_host_level/files/suricata/suricata.rules
    - path: /etc/firewalld/zones/fcos-workspace.xml
      mode: 0644
      overwrite: true
      contents:
        local: 1_host_level/files/firewalld/firewall-rules.xml

    # ---- 3_container_level ---------------------------------------------
    - path: /opt/kasm/docker-compose.yaml
      mode: 0644
      overwrite: true
      contents:
        local: 3_container_level/kasm/docker-compose.yaml

    # ---- helper script used by security-finalize.service ----------------
    - path: /usr/local/sbin/security-finalize.sh
      mode: 0755
      overwrite: true
      contents:
        local: 2_systemd_level/security-finalize.sh

systemd:
  units:
    # ---- 2_systemd_level ----------------------------------------------
    - name: security-setup.service
      enabled: true
      contents_local: 2_systemd_level/security-setup.service
    - name: security-finalize.service
      enabled: true
      contents_local: 2_systemd_level/security-finalize.service
    - name: kasm-workspace.service
      enabled: false   # enabled by security-finalize once docker exists
      contents_local: 2_systemd_level/kasm-workspace.service
    - name: home-security.service
      enabled: false   # enabled by security-finalize once docker exists
      contents_local: 2_systemd_level/home-security.service
    - name: clamav-daily.service
      contents_local: 2_systemd_level/clamav-daily.service
    - name: clamav-daily.timer
      enabled: true
      contents_local: 2_systemd_level/clamav-daily.timer
    - name: aide-daily.service
      contents_local: 2_systemd_level/aide-daily.service
    - name: aide-daily.timer
      enabled: true
      contents_local: 2_systemd_level/aide-daily.timer
    - name: container-update.service
      contents_local: 2_systemd_level/container-update.service
    - name: container-update.timer
      enabled: true
      contents_local: 2_systemd_level/container-update.timer
    - name: lynis-daily.service
      contents_local: 2_systemd_level/lynis-daily.service
    - name: lynis-daily.timer
      enabled: true
      contents_local: 2_systemd_level/lynis-daily.timer
