# Applied to /etc/suricata/suricata.rules — local rules loaded in addition to
# the ET Open set fetched by suricata-update. Keep this file small; heavy
# lifting belongs in the managed ruleset.

# ---------------------------------------------------------------------------
# Local policy rules (ET Open rules are appended by suricata-update).
# Alert on common hostile indicators seen on the lab LAN.
# ---------------------------------------------------------------------------

# ET POLICY — count/reject inbound cleartext management protocols outside LAN
alert tcp $HOME_NET any -> ![192.168.1.0/24] 23 (msg:"ET POLICY Telnet outbound attempt"; flow:to_server; classtype:policy-violation; sid:9000001; rev:1;)
alert tcp $HOME_NET any -> ![192.168.1.0/24] 21 (msg:"ET POLICY FTP outbound attempt"; flow:to_server; classtype:policy-violation; sid:9000002; rev:1;)

# ET SCAN — vertical TCP SYN scan against the VM
alert tcp any any -> $HOME_NET any (msg:"ET SCAN Possible TCP SYN scan"; flags:S,12; threshold:type both,track by_src,count 50,seconds 10; classtype:attempted-recon; sid:9000010; rev:1;)

# ET MALWARE — placeholder group for locally-added malware signatures
# Include drop-in files here if you vendor extra rules, e.g.:
# include urlhause.rules
