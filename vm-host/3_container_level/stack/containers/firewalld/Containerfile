# vm-host firewalld container — Fedora base + firewalld/nftables only.
FROM registry.fedoraproject.org/fedora:44
RUN dnf install -y --setopt=install_weak_deps=False firewalld nftables \
    && dnf clean all
# Runs with network_mode: host + NET_ADMIN; firewalld manages the host
# nftables ruleset through the shared netns.
ENTRYPOINT ["/usr/sbin/firewalld", "--nofork", "--nopid"]
