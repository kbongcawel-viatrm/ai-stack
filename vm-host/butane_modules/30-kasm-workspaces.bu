variant: fcos
version: 1.5.0

# 30-kasm-workspaces — standalone KasmVNC workspace compose stack.
# Toggle: ENABLE_KASM.
# security-finalize stages the compose under /var/opt/kasm (runtime-writable)
# together with a generated .env, then starts kasm-workspace.service.
storage:
  directories:
    - path: /opt/kasm
      mode: 0755
  files:
    - path: /opt/kasm/docker-compose.yaml
      mode: 0644
      overwrite: true
      contents:
        local: 3_container_level/kasm/docker-compose.yaml

systemd:
  units:
    - name: kasm-workspace.service
      # enabled by security-finalize once the compose is staged with .env
      enabled: false
      contents_local: 2_systemd_level/kasm-workspace.service
    - name: container-update.service
      contents_local: 2_systemd_level/container-update.service
    - name: container-update.timer
      enabled: true
      contents_local: 2_systemd_level/container-update.timer
