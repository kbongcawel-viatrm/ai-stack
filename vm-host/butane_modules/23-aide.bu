variant: fcos
version: 1.5.0

# 23-aide — policy + daily integrity check pair.
# Toggle: ENABLE_AIDE.
# The baseline is initialized ONCE by security-finalize; the checks only verify.
storage:
  directories:
    - path: /etc/aide
      mode: 0750
    - path: /var/lib/aide
      mode: 0750
    - path: /var/log/aide
      mode: 0750
  files:
    - path: /etc/aide/aide.conf
      mode: 0640
      overwrite: true
      contents:
        local: 1_host_level/files/aide/aide.conf

systemd:
  units:
    - name: aide-daily.service
      contents_local: 2_systemd_level/aide-daily.service
    - name: aide-daily.timer
      enabled: true
      contents_local: 2_systemd_level/aide-daily.timer
