variant: fcos
version: 1.5.0

# 22-clamav — freshclam config + daily update/scan pair.
# Toggle: ENABLE_CLAMAV.
# The packaged freshclam daemons are masked in the base layer; updates run
# through clamav-daily.timer only.
storage:
  directories:
    - path: /etc/clamav
      mode: 0750
    - path: /var/lib/clamav
      mode: 0750
  files:
    - path: /etc/clamav/freshclam.conf
      mode: 0640
      overwrite: true
      contents:
        local: 1_host_level/files/clamav/freshclam.conf

systemd:
  units:
    - name: clamav-daily.service
      contents_local: 2_systemd_level/clamav-daily.service
    - name: clamav-daily.timer
      enabled: true
      contents_local: 2_systemd_level/clamav-daily.timer
