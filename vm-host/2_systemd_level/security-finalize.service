[Unit]
Description=Post-layering security finalize (idempotent, every boot)
Documentation=https://github.com/kbongcawel-viatrm/ai-stack/tree/devin/vm-host
After=network-online.target security-setup.service
Wants=network-online.target
# Only meaningful once rpm-ostree packages are installed; the script itself
# also guards on the stamp file.
ConditionPathExists=/var/lib/vm-host-packages.stamp

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/security-finalize.sh
TimeoutStartSec=900

[Install]
WantedBy=multi-user.target
