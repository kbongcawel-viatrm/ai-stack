[Unit]
Description=Kasm workspace container lifecycle manager
Documentation=https://github.com/kbongcawel-viatrm/ai-stack/tree/devin/vm-host
# Start after docker is available (installed via rpm-ostree layering).
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service
ConditionPathExists=/opt/kasm/docker-compose.yaml

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/kasm
# Pull latest pinned images, then (re)create the stack.
ExecStartPre=/usr/bin/docker compose -f /opt/kasm/docker-compose.yaml pull
ExecStart=/usr/bin/docker compose -f /opt/kasm/docker-compose.yaml up -d
ExecStop=/usr/bin/docker compose -f /opt/kasm/docker-compose.yaml down
TimeoutStartSec=600

[Install]
WantedBy=multi-user.target
