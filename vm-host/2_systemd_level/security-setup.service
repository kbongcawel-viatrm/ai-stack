[Unit]
Description=VM host first-boot security setup (rpm-ostree layering)
Documentation=https://github.com/kbongcawel-viatrm/ai-stack/tree/devin/vm-host
After=network-online.target
Wants=network-online.target
Before=sshd.service firewalld.service suricata.service
# Run once: stamp file prevents re-layering on subsequent boots.
ConditionPathExists=!/var/lib/vm-host-packages.stamp

[Service]
Type=oneshot
RemainAfterExit=yes
# @VM_HOST_PACKAGES@ is substituted by vm-host/build.sh from the ENABLE_* toggles.
# --apply-live layers AND activates the deployment in the running boot — no
# reboot needed. If the dep closure isn't live-upgradeable the unit fails
# visibly (check journalctl) rather than looping reboots.
ExecStart=/usr/bin/rpm-ostree install --apply-live @VM_HOST_PACKAGES@
# Stamp so this unit never runs twice.
ExecStartPost=/usr/bin/touch /var/lib/vm-host-packages.stamp
TimeoutStartSec=600

[Install]
WantedBy=multi-user.target
