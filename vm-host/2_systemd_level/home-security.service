[Unit]
Description=home-security.uk v2 stack (clone + docker compose up)
Documentation=https://github.com/kbongcawel-viatrm/v2.home-security.uk
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service
# Runs after the Kasm stack; independent compose project in /var/opt/home-security.

[Service]
Type=oneshot
RemainAfterExit=yes
# The upstream repo contains local/* images (openobserve-with-curl,
# fluent-bit-hardened) that must be built on-host first — see its scripts/
# and worker-image/ directories. This unit only ensures the checkout exists
# and brings the stack up; image builds are a manual/pre-seeded step.
ExecStart=/usr/bin/bash -c '\
  set -e; \
  if [ ! -d /var/opt/home-security/.git ]; then \
    git clone --depth 1 https://github.com/kbongcawel-viatrm/v2.home-security.uk /var/opt/home-security; \
  fi; \
  cd /var/opt/home-security/v2.home-security.uk && \
  /usr/bin/docker compose pull --ignore-buildable 2>/dev/null || true; \
  /usr/bin/docker compose up -d'
ExecStop=/usr/bin/bash -c 'cd /var/opt/home-security/v2.home-security.uk && /usr/bin/docker compose down'
TimeoutStartSec=900

[Install]
WantedBy=multi-user.target
