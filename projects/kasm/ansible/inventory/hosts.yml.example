---
all:
  children:
    hypervisors:
      hosts:
        hypervisor:
          ansible_host: 192.168.1.10
          ansible_user: root
          ansible_become: false
          host_os: alpine
          fcos_vm_name: fcos-security
          fcos_network_bridge: br0
          fcos_vm_memory_mb: 4096
          fcos_vm_vcpus: 2
          fcos_vm_disk_gb: 75
          # For diskless Alpine, this must be on the mounted local NVMe volume.
          fcos_storage_mountpoint: /mnt/nvme
          fcos_image_dir: /mnt/nvme/libvirt/images
          fcos_lan_ip: 192.168.1.201
          # Ubuntu defaults: libvirt-qemu:kvm. Alpine/Secureblue/Arch: qemu:qemu.
          fcos_qemu_user: qemu
          fcos_qemu_group: qemu
          fcos_qcow2_url: REPLACE_WITH_PINNED_UNCOMPRESSED_FCOS_QCOW2_URL
          fcos_qcow2_sha256: REPLACE_WITH_64_HEX_SHA256
    fcos:
      hosts:
        fcos-security:
          ansible_host: 192.168.1.201
          ansible_user: core
          fcos_lan_ip: 192.168.1.201
          fcos_lan_cidr: 192.168.1.0/24
          fcos_interface: ens2
          suricata_test_target_ip: 192.168.1.50 # Must be a real LAN HTTP endpoint
  vars:
    ansible_python_interpreter: auto_silent
    ansible_ssh_common_args: "-o ServerAliveInterval=30 -o ServerAliveCountMax=3"
