---
all:
  children:
    hypervisors:
      hosts:
        hypervisor:
          ansible_host: 192.168.1.10
          ansible_user: root
          host_os: alpine
          fcos_vm_name: fcos-security
          fcos_network_bridge: br0
          fcos_vm_memory_mb: 4096
          fcos_vm_vcpus: 2
          fcos_vm_disk_gb: 75
          fcos_lan_ip: 192.168.1.20
    fcos:
      hosts:
        fcos-security:
          ansible_host: 192.168.1.20
          ansible_user: core
          fcos_lan_ip: 192.168.1.20
          fcos_lan_cidr: 192.168.1.0/24
          fcos_interface: enp1s0
          suricata_test_target_ip: 192.168.1.50
  vars:
    ansible_python_interpreter: auto_silent
    ansible_ssh_common_args: "-o ServerAliveInterval=30 -o ServerAliveCountMax=3"
