---
all:
  children:
    hypervisors:
      hosts:
        hypervisor:
          ansible_host: 192.168.1.10
          ansible_user: root
          host_os: alpine
          fcos_vm_name: fcos-security
    fcos:
      hosts:
        fcos-security:
          ansible_host: 192.168.1.201
          ansible_user: core
          fcos_lan_ip: 192.168.1.201
          fcos_lan_cidr: 192.168.1.0/24
          fcos_interface: ens2
          aide_enable_daily_timer: false
  vars:
    ansible_python_interpreter: auto_silent
