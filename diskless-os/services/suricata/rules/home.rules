# HOME SECURITY - Inbound Telnet
alert tcp $EXTERNAL_NET any -> $HOME_NET 23 (
    msg:"HOME-SECURITY Inbound Telnet connection attempt";
    flow:to_server;
    sid:1000001;
    rev:2;
)

# HOME SECURITY - Inbound SMB
alert tcp $EXTERNAL_NET any -> $HOME_NET 445 (
    msg:"HOME-SECURITY Inbound SMB connection attempt";
    flow:to_server;
    sid:1000002;
    rev:2;
)

# HOME SECURITY - Inbound NetBIOS
alert tcp $EXTERNAL_NET any -> $HOME_NET 139 (
    msg:"HOME-SECURITY Inbound NetBIOS session connection attempt";
    flow:to_server;
    sid:1000003;
    rev:2;
)

# HOME SECURITY - Inbound RDP
alert tcp $EXTERNAL_NET any -> $HOME_NET 3389 (
    msg:"HOME-SECURITY Inbound RDP connection attempt";
    flow:to_server;
    sid:1000004;
    rev:2;
)

# HOME SECURITY - Outbound Telnet
alert tcp $HOME_NET any -> $EXTERNAL_NET 23 (
    msg:"HOME-SECURITY Outbound Telnet connection attempt";
    flow:to_server;
    sid:1000005;
    rev:2;
)