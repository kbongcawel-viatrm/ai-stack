variant: fcos
version: 1.6.0

# firewalld fragment: declarative zone/policy/bootstrap-nftables files, the
# pre-firewalld bootstrap oneshot, and a post-boot verification oneshot.
storage:
  directories:
    - path: /etc/firewalld/zones
      mode: 0750
    - path: /etc/firewalld/policies
      mode: 0750
    - path: /etc/nftables
      mode: 0750
    - path: /etc/systemd/system/firewalld.service.d
      mode: 0755

  files:
    - path: /etc/firewalld/firewalld.conf
      mode: 0644
      overwrite: true
      contents:
        inline: |
          @@include diskless-os/services/firewalld/firewalld.conf@@

    - path: /etc/firewalld/zones/public.xml
      mode: 0640
      overwrite: true
      contents:
        inline: |
          @@include diskless-os/services/firewalld/public.xml@@

    - path: /etc/firewalld/policies/fcos-host-egress.xml
      mode: 0640
      overwrite: true
      contents:
        inline: |
          @@include diskless-os/services/firewalld/fcos-host-egress.xml@@

    # Temporary bootstrap firewall: FCOS does not ship firewalld in its base
    # image. This nftables policy protects first boot and remains active until
    # Ansible verifies the layered Firewalld policy.
    - path: /etc/nftables/fcos-bootstrap.nft
      mode: 0600
      overwrite: true
      contents:
        inline: |
          @@include diskless-os/services/firewalld/fcos-bootstrap.nft@@

    - path: /etc/systemd/system/firewalld.service.d/10-fcos-bootstrap.conf
      mode: 0644
      overwrite: true
      contents:
        inline: |
          @@include diskless-os/services/firewalld/10-fcos-bootstrap.conf@@

    # firewalld ships in the rpm-ostree layer; wait for the first-boot layer
    # unit so the vendor unit does not start before its binaries exist.
    - path: /etc/systemd/system/firewalld.service.d/20-fcos-package-layer.conf
      mode: 0644
      overwrite: true
      contents:
        inline: |
          @@include diskless-os/services/firewalld/20-fcos-package-layer.conf@@

    - path: /usr/local/sbin/provision-firewalld
      mode: 0750
      overwrite: true
      contents:
        inline: |
          @@include diskless-os/services/firewalld/provision-firewalld.sh@@

systemd:
  units:
    - name: fcos-bootstrap-firewall.service
      enabled: true
      contents: |
        [Unit]
        Description=Temporary FCOS bootstrap nftables firewall
        DefaultDependencies=no
        After=local-fs.target
        Before=NetworkManager.service
        ConditionFileIsExecutable=/usr/sbin/nft

        [Service]
        Type=oneshot
        ExecStartPre=-/usr/sbin/nft delete table inet fcos_bootstrap
        ExecStartPre=/usr/sbin/nft -c -f /etc/nftables/fcos-bootstrap.nft
        ExecStart=/usr/sbin/nft -f /etc/nftables/fcos-bootstrap.nft
        ExecStop=-/usr/sbin/nft delete table inet fcos_bootstrap
        RemainAfterExit=yes
        CapabilityBoundingSet=CAP_NET_ADMIN
        AmbientCapabilities=CAP_NET_ADMIN
        # NoNewPrivileges intentionally omitted: FCOS SELinux denies the
        # init_t -> iptables_t bounded transition (nnp_transition) for nft.
        RestrictAddressFamilies=AF_NETLINK AF_INET AF_INET6
        ProtectSystem=full
        ProtectHome=true
        PrivateTmp=true

        [Install]
        WantedBy=multi-user.target

    - name: firewalld.service
      enabled: true

    - name: firewalld-provision.service
      enabled: true
      contents: |
        [Unit]
        Description=Verify FCOS firewalld default-DROP and LAN-only SSH policy
        After=firewalld.service fcos-package-layer.service fcos-services-preflight.service
        Wants=firewalld.service

        [Service]
        Type=oneshot
        ExecStart=/usr/local/sbin/provision-firewalld
        RemainAfterExit=yes
        # NoNewPrivileges omitted: SELinux domain transitions need it unset.
        PrivateTmp=true
        ProtectSystem=full
        ProtectHome=read-only
        ProtectKernelTunables=true
        ProtectKernelModules=true
        ProtectControlGroups=true
        LockPersonality=true
        RestrictSUIDSGID=true
        ProtectClock=true
        RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
        UMask=0077
        TimeoutStartSec=5m

        [Install]
        WantedBy=multi-user.target
