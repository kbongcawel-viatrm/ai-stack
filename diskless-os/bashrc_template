# workspace navigator
workspace() {
    local target_dir="$HOME/workspace"
    local -a folders=()
    local item choice selected_folder
    local choice_num i

    # 1. Verify the workspace directory exists
    if [[ ! -d "$target_dir" ]]; then
        printf 'Error: Directory %s does not exist.\n' "$target_dir" >&2
        return 1
    fi

    # 2. Collect subdirectories, preserving spaces in names
    for item in "$target_dir"/*; do
        [[ -d "$item" ]] || continue
        folders+=("${item##*/}")
    done

    # 3. Handle an empty workspace
    if (( ${#folders[@]} == 0 )); then
        printf 'No subfolders found in %s.\n' "$target_dir"
        return 0
    fi

    # 4. Display the numbered list
    printf 'Which folder do you want to enter?\n'
    for i in "${!folders[@]}"; do
        printf '%d. %s\n' "$((i + 1))" "${folders[$i]}"
    done

    # 5. Read the selection
    read -r -p 'Enter number: ' choice || return 1

    # 6. Validate the selection
    if [[ ! "$choice" =~ ^[0-9]+$ ]]; then
        printf 'Error: Enter a valid number.\n' >&2
        return 1
    fi

    choice_num=$((10#$choice))

    if (( choice_num < 1 || choice_num > ${#folders[@]} )); then
        printf 'Error: Selection out of range.\n' >&2
        return 1
    fi

    # 7. Change the current shell's directory
    selected_folder="${folders[$((choice_num - 1))]}"

    if ! cd -- "$target_dir/$selected_folder"; then
        printf 'Error: Could not enter directory.\n' >&2
        return 1
    fi

    printf 'Moved to: %s\n' "$PWD"

}

