# ============================================================
# GLOBAL TERMINAL LOADER
# ============================================================

_LOADER_PID=""
_LOADER_ICON="📦"
_LOADER_DELAY="0.05"

# Start shared animated loader.
# Usage: _loader_start [icon] [delay]
_loader_start() {
    local icon="${1:-📦}"
    local delay="${2:-0.05}"
    local width max

    # Prevent duplicate loaders.
    [[ -n "${_LOADER_PID:-}" ]] && return 0

    # Do not animate without an interactive terminal.
    [[ -t 2 && -w /dev/tty ]] || return 0

    # Validate delay.
    if [[ ! "$delay" =~ ^[0-9]+([.][0-9]+)?$ ]]; then
        delay="0.05"
    fi

    width=$(stty size </dev/tty 2>/dev/null)
    width=${width##*$'\t'}
    [[ "$width" =~ ^[0-9]+$ ]] || width=40

    (( width > 6 )) || width=40
    max=$((width - 4))

    _LOADER_ICON="$icon"
    _LOADER_DELAY="$delay"

    # Background animation.
    (
        trap 'printf "\033[?25h" >/dev/tty 2>/dev/null' EXIT
        trap 'exit 0' INT TERM HUP

        printf '\033[?25l' >/dev/tty 2>/dev/null || exit 0

        local i

        while :; do
            for ((i=0; i<=max; i++)); do
                printf '\r\033[K%*s%s' \
                    "$i" "" "$icon" >/dev/tty 2>/dev/null || exit 0
                sleep "$delay" || exit 0
            done

            for ((i=max; i>=0; i--)); do
                printf '\r\033[K%*s%s' \
                    "$i" "" "$icon" >/dev/tty 2>/dev/null || exit 0
                sleep "$delay" || exit 0
            done
        done
    ) </dev/null >/dev/null 2>&1 &

    _LOADER_PID=$!
}

# Stop shared loader.
_loader_stop() {
    local pid="${_LOADER_PID:-}"

    if [[ -n "$pid" ]]; then
        kill "$pid" 2>/dev/null || :
        wait "$pid" 2>/dev/null || :
        _LOADER_PID=""
    fi

    if [[ -w /dev/tty ]]; then
        printf '\r\033[K\033[?25h' >/dev/tty 2>/dev/null || :
    fi
}

# Execute a command with animation.
# Usage: _loader_run [icon] [delay] command [arguments...]
_loader_run() {
    local icon="${1:-📦}"
    local delay="${2:-0.05}"
    local rc

    shift 2

    if (( $# == 0 )); then
        printf 'Usage: _loader_run [icon] [delay] command [args...]\n' >&2
        return 2
    fi

    _loader_start "$icon" "$delay"

    "$@"
    rc=$?

    _loader_stop

    return "$rc"
}


