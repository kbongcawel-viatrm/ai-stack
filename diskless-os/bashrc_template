# Back up user dotfiles for Fedora Secureblue workspace recovery
workspacesync() {
    local SRC=$HOME
    local DEST=$HOME/workspace/dotfiles-backup

    load_progress() {
        # Get the height of your current terminal window
        #height=$(tput lines)
        width=$(tput cols)
        
	_terminal_msg_normal " Transfering ...🚀 "
        for ((i=0; i<height-2; i++)); do
           # \r resets to start of line; %${i}s prints 'i' spaces; then the package
	   printf "\r%${i}s📦" ""
    
           # Pause for 0.15 seconds (increase for slower, decrease for faster)
           sleep 0.15
	done

	# Reset the cursor
	tput cnorm
        echo ""
      }

    if [ ! -d "$DEST" ]; then
       _terminal_msg error " Destination path doesn't exist ⛔ "
    else
       _terminal_msg normal " Destination path exists, copying files...📦 "
       load_progress
       # 2. Copy the explicit files and directory structures
       cp ~/.gitconfig "$DEST" || return 1
       cp ~/.bashrc "$DEST" || return 1
       cp ~/.bash_profile "$DEST" || return 1

       # 3. Safely copy structures (retaining nested directories)
       cp -r ~/.cline "$DEST" || return 1
       cp -r ~/.config/containers "$DEST" || return 1

       # 4. Copy your local workspace code and workspace specifications
       mkdir -p "$DEST/Documents"
       cp -r ~/Documents/Cline "$DEST/Documents" || return 1
       cp -r ~/workspace "$DEST" || return 1

       # 5. Backup your Toolbx containers dynamically into the staging folder
       # (This creates a clean tar file instead of breaking permissions)
       if command -v podman >/dev/null 2>&1 && command -v toolbox >/dev/null 2>&1; then
           podman export $(toolbox list | awk 'NR>1 {print $2}') -o "$DEST/toolbox_backup.tar" || return 1
       fi

       _terminal_msg success " Done copying files. Bye ☕ "
    fi

}

# Dedicated SSH agent for the home-security key
workspaceagent() {
    local key="$HOME/.ssh/home-security"
    local agent_output

    if ! declare -F tcat >/dev/null ||
       ! command -v ssh-agent >/dev/null 2>&1 ||
       ! command -v ssh-add >/dev/null 2>&1; then
        return 1
    fi

    if [[ ! -f "$key" || ! -r "$key" ]]; then
        _terminal_msg error "🔴 ERROR: SSH key missing or unreadable."
        return 1
    fi

    if [[ -n "${HOME_SECURITY_SSH_AGENT_PID:-}" ]] &&
       kill -0 "$HOME_SECURITY_SSH_AGENT_PID" 2>/dev/null; then
        _terminal_msg success "🚀 Home-security SSH agent is already running."
        return 0
    fi

    # Preserve the current SSH agent environment.
    HOME_SECURITY_PREV_SOCK="${SSH_AUTH_SOCK-}"
    HOME_SECURITY_PREV_PID="${SSH_AGENT_PID-}"
    HOME_SECURITY_PREV_SOCK_SET=${SSH_AUTH_SOCK+x}
    HOME_SECURITY_PREV_PID_SET=${SSH_AGENT_PID+x}

    # Start a dedicated agent without printing its environment.
    if ! agent_output=$(umask 077; ssh-agent -s 2>/dev/null); then
        _terminal_msg error "🔴 ERROR: Could not start ssh-agent."
        return 1
    fi

    eval "$agent_output" >/dev/null 2>&1

    HOME_SECURITY_SSH_AGENT_PID="$SSH_AGENT_PID"
    HOME_SECURITY_SSH_AUTH_SOCK="$SSH_AUTH_SOCK"

    # Load the key for 15 minutes; show ssh-add output on the terminal.
    if ! ssh-add -t 900 "$key" > /dev/tty 2>&1; then
	workspacekill
        _terminal_msg error "🔴 ERROR: Could not load the SSH key."
        return 1
    fi

    # Clean up this dedicated agent when the shell exits.
    trap 'workspacekill' EXIT

    _terminal_msg success \
        "🚀 Home-security session started (PID $HOME_SECURITY_SSH_AGENT_PID)."
    _terminal_msg normal "🔑 Key lifetime: 15 minutes."

}

# Kill all ssh-agent processes owned by the current user.
# Terminate all ssh-agent processes owned by the current user.
workspacekill() {
_terminal_msg red '🚨 Terminating all sessions.'
run0 pkill -f 'ssh-agent'
_terminal_msg normal '👁️ Post termination checks'
echo
run0 ps -aux | grep 'ssh-agent'
echo
_terminal_msg normal "🐧 Termination signals sent. Processes may take time to exit."
}

# google sync
workspacesgsync() {
    local PROJECT_ID="home-security-511714"
    local BUCKET="gs://home-security-bucket"
    local SOURCE_DIR="$HOME/workspace"
    local DESTINATION="$BUCKET/workspace"
    local LOADER_PID=""
    local had_job_control=0
    local exit_code=0
    local gcloud_log

    # Validate required commands.
    for cmd in gcloud tput sleep mktemp; do
        if ! command -v "$cmd" >/dev/null 2>&1; then
            _terminal_msg error "Required command not found: $cmd ⚠️ "
            return 1
        fi
    done

    # Validate source directory.
    if [[ ! -d "$SOURCE_DIR" ]]; then
        _terminal_msg error "Source directory does not exist: $SOURCE_DIR ⚠️ "
        return 1
    fi

    # Create temporary error log.
    gcloud_log=$(mktemp "${TMPDIR:-/tmp}/gcloud-sync.XXXXXX") || {
        _terminal_msg error "Could not create temporary log. ⚠️"
        return 1
    }

    # Animated loader.
    load_progress() {
        local width i

        width=$(tput cols 2>/dev/null) || width=40
        (( width > 4 )) || width=40

        printf '\033[?25l' >/dev/tty 2>/dev/null || :

        while :; do
            for ((i=0; i<width-3; i++)); do
                printf '\r\033[K%*s📦' "$i" "" >/dev/tty
                sleep 0.05
            done

            for ((i=width-3; i>=0; i--)); do
                printf '\r\033[K%*s📦' "$i" "" >/dev/tty
                sleep 0.05
            done
        done
    }

    # Stop loader and restore cursor.
    stop_loader() {
        if [[ -n "$LOADER_PID" ]]; then
            kill "$LOADER_PID" 2>/dev/null || :
            wait "$LOADER_PID" 2>/dev/null || :
            LOADER_PID=""
        fi

        printf '\r\033[K\033[?25h' >/dev/tty 2>/dev/null || :
    }

    _terminal_msg normal "Checking source directory 📂"
    _terminal_msg normal "Source: $SOURCE_DIR"
    _terminal_msg normal "Destination: $DESTINATION"
    _terminal_msg normal "Project: $PROJECT_ID"

    # Suppress background-job notifications while loader runs.
    case "$-" in
        *m*) had_job_control=1; set +m ;;
    esac

    # Start animated loader.
    load_progress >/dev/null 2>&1 &
    LOADER_PID=$!

    # Execute GCloud synchronization.
    if CLOUDSDK_METRICS_REQUEST_ATTRIBUTION="agent-skills/1.0 (skill:gcloud)" \
        gcloud storage rsync "$SOURCE_DIR" "$DESTINATION" \
            --recursive \
            --quiet \
            --project="$PROJECT_ID" \
            >/dev/null 2>"$gcloud_log"; then

        exit_code=0
    else
        exit_code=$?
    fi

    # Always stop loader after GCloud returns.
    stop_loader

    # Restore original job-control setting.
    if (( had_job_control )); then
        set -m
    fi

    # Display final result.
    if (( exit_code == 0 )); then
        rm -f -- "$gcloud_log"
        _terminal_msg success "Google Cloud Storage synchronization completed! 🚀"
        return 0
    else
        _terminal_msg error \
            "Google Cloud Storage synchronization failed (exit code: $exit_code). ⚠️ "

        _terminal_msg warning "GCloud error details: ⚠️ "
        tcat "$gcloud_log"

        _terminal_msg normal "Error log: $gcloud_log ⚠️"
        return "$exit_code"
    fi
}
