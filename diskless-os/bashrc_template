# Display file contents directly in the terminal
tcat() {
    if [[ ! -w /dev/tty ]]; then
        printf 'Error: No writable terminal available.\n' >&2
        return 1
    fi

    command cat -- "$@" > /dev/tty
}

# terminal output hardening
_terminal_msg() {
    local status="$1"
    shift

    local color
    case "$status" in
        success) color='1;32' ;;  # Bold, default Green
        error)   color='1;31' ;;  # Bold, default Red
        warning) color='1;33' ;;  # Bold, default Yellow
        normal)  color='1'  ;;  # Bold, default foreground color
        *)       color='0'  ;;  # Default/reset
esac 

    printf '\033[%sm%s\033[0m\n' "$color" "$*" | tcat
}

shazam() {
  # Runs the target utility inside the systemd execution framework
  # --empower dynamically elevates or assigns capabilities
  # --property=LogLevelMax=0 silences systemd-level log generation for this fork
  run0 --empower && _terminal_msg warning "With great power comes with great responsibility"
}

# workspace navigator
workspace() {
    local target_dir="$HOME/workspace"
    local -a folders=()
    local item choice selected_folder
    local choice_num i

    # 1. Verify the workspace directory exists
    if [[ ! -d "$target_dir" ]]; then
        printf 'Error: Directory %s does not exist.\n' "$target_dir" >&2
        return 1
    fi

    # 2. Collect subdirectories, preserving spaces in names
    for item in "$target_dir"/*; do
        [[ -d "$item" ]] || continue
        folders+=("${item##*/}")
    done

    # 3. Handle an empty workspace
    if (( ${#folders[@]} == 0 )); then
        printf 'No subfolders found in %s.\n' "$target_dir"
        return 0
    fi

    # 4. Display the numbered list
    printf 'Which folder do you want to enter?\n'
    for i in "${!folders[@]}"; do
        printf '%d. %s\n' "$((i + 1))" "${folders[$i]}"
    done

    # 5. Read the selection
    read -r -p 'Enter number: ' choice || return 1

    # 6. Validate the selection
    if [[ ! "$choice" =~ ^[0-9]+$ ]]; then
        printf 'Error: Enter a valid number.\n' >&2
        return 1
    fi

    choice_num=$((10#$choice))

    if (( choice_num < 1 || choice_num > ${#folders[@]} )); then
        printf 'Error: Selection out of range.\n' >&2
        return 1
    fi

    # 7. Change the current shell's directory
    selected_folder="${folders[$((choice_num - 1))]}"

    if ! cd -- "$target_dir/$selected_folder"; then
        printf 'Error: Could not enter directory.\n' >&2
        return 1
    fi

    printf 'Moved to: %s\n' "$PWD"

}

