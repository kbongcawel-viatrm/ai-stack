variant: fcos
version: 1.6.0

# Fedora CoreOS packages are layered with rpm-ostree, not a Butane packages key.
# This first-boot service stages the required host-level security/service tools
# and reboots into the new deployment. Podman is part of the FCOS base image;
# podman-compose is layered here. Kasm is not installed in this Podman POC.
# AIDE and Lynis are intentionally excluded: they may be deployed as containers.
storage:
  directories:
    - path: /var/lib
      mode: 0755

systemd:
  units:
    - name: fcos-package-layer.service
      enabled: true
      contents: |
        [Unit]
        Description=Layer required FCOS host security service packages
        ConditionPathExists=!/var/lib/rpm-ostree-install.stamp
        Wants=network-online.target
        After=network-online.target
        Before=multi-user.target

        [Service]
        Type=oneshot
        ExecStart=/bin/bash -c 'set -e; echo FCOS-LAYER-START-$(date --iso-8601=seconds); /usr/bin/rpm-ostree install --idempotent --allow-inactive python3 firewalld nftables suricata clamav clamav-freshclam podman-compose logrotate || { echo FCOS-LAYER-INSTALL-FAILED-$(date --iso-8601=seconds) >&2; exit 1; }; command -v python3 firewall-cmd nft suricata clamscan freshclam podman-compose logrotate >/dev/null 2>&1 || { echo FCOS-LAYER-MISSING-BINARY-$(date --iso-8601=seconds) >&2; command -v python3 firewall-cmd nft suricata clamscan freshclam podman-compose logrotate; exit 1; }; /usr/bin/touch /var/lib/rpm-ostree-install.stamp && echo FCOS-LAYER-STAMP-WRITTEN-$(date --iso-8601=seconds) && echo FCOS-LAYER-REBOOTING-$(date --iso-8601=seconds) && /usr/bin/systemctl reboot'
        StandardOutput=journal+console
        StandardError=journal+console
        TimeoutStartSec=0

        [Install]
        WantedBy=multi-user.target