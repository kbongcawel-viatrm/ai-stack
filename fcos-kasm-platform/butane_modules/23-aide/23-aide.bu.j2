# 23-aide — AIDE file-integrity config, baseline init, daily check timer.
# aide-init.service builds the baseline DB once and enables the timer after
# rpm-ostree layering.
variant: fcos
version: 1.5.0

storage:
  directories:
    - path: /etc/aide
      mode: 0750
    - path: /var/lib/aide
      mode: 0750
    - path: /var/log/aide
      mode: 0750
    - path: /usr/local/sbin
      mode: 0755
  files:
    - path: /etc/aide/aide.conf
      mode: 0640
      overwrite: true
      contents:
        local: files/aide.conf
    - path: /usr/local/sbin/aide-init.sh
      mode: 0755
      overwrite: true
      contents:
        local: files/aide-init.sh

systemd:
  units:
    - name: aide-init.service
      enabled: true
      contents: |
        [Unit]
        Description=AIDE baseline init and timer enable (post rpm-ostree layering)
        After=local-fs.target rpm-ostree-layer.service
        ConditionPathExists=/var/lib/rpm-ostree-install.stamp
        ConditionPathExists=/etc/aide/aide.conf

        [Service]
        Type=oneshot
        RemainAfterExit=yes
        ExecStart=/usr/local/sbin/aide-init.sh
        TimeoutStartSec=600

        [Install]
        WantedBy=multi-user.target

    - name: aide-daily.service
      contents: |
        [Unit]
        Description=Daily AIDE file-integrity check
        After=local-fs.target

        [Service]
        Type=oneshot
        ExecStart=/usr/bin/aide --check --config=/etc/aide/aide.conf
        # Non-zero exit = differences found; report but don't fail loudly.
        SuccessExitStatus=0 1 2

    - name: aide-daily.timer
      contents: |
        [Unit]
        Description=Run aide-daily daily at 04:15

        [Timer]
        OnCalendar=*-*-* 04:15:00
        Persistent=true

        [Install]
        WantedBy=timers.target
