# 20-firewalld — firewalld package config + post-layering zone binding.
#
# The fcos-workspace zone (ssh + Kasm ports only) is installed declaratively;
# firewalld-init.service binds it to the guest NIC and enables the service
# after rpm-ostree layering completes (the package does not exist at first boot).
variant: fcos
version: 1.5.0

storage:
  directories:
    - path: /etc/firewalld/zones
      mode: 0755
    - path: /usr/local/sbin
      mode: 0755
  files:
    - path: /etc/firewalld/zones/fcos-workspace.xml
      mode: 0644
      overwrite: true
      contents:
        local: files/firewall-rules.xml
    - path: /usr/local/sbin/firewalld-init.sh
      mode: 0755
      overwrite: true
      contents:
        local: files/firewalld-init.sh

systemd:
  units:
    - name: firewalld-init.service
      enabled: true
      contents: |
        [Unit]
        Description=Firewalld zone binding and enable (post rpm-ostree layering)
        After=network-online.target rpm-ostree-layer.service
        Wants=network-online.target
        ConditionPathExists=/var/lib/rpm-ostree-install.stamp
        ConditionPathExists=/etc/firewalld/zones/fcos-workspace.xml

        [Service]
        Type=oneshot
        RemainAfterExit=yes
        ExecStart=/usr/local/sbin/firewalld-init.sh
        TimeoutStartSec=120

        [Install]
        WantedBy=multi-user.target
