# 10-rpm-ostree — dynamic package layering.
#
# rpm-ostree-layer.service installs every package in `rpm_ostree_packages`
# (assembled in group_vars/all.yml from the enable_* toggles), stamps
# /var/lib/rpm-ostree-install.stamp BEFORE rebooting so it never re-runs, then
# reboots once. All service modules gate their init units on that stamp.
variant: fcos
version: 1.5.0

systemd:
  units:
    - name: rpm-ostree-layer.service
      enabled: true
      contents: |
        [Unit]
        Description=Layer rpm-ostree packages (one-shot, single reboot)
        After=network-online.target
        Wants=network-online.target
        # Run once: stamp file prevents re-layering on subsequent boots.
        ConditionPathExists=!/var/lib/rpm-ostree-install.stamp

        [Service]
        Type=oneshot
        RemainAfterExit=yes
        ExecStart=/usr/bin/rpm-ostree install {{ rpm_ostree_packages | join(' ') }}
        # Stamp BEFORE reboot so this unit never runs twice (prevents reboot loop).
        ExecStartPost=/usr/bin/touch /var/lib/rpm-ostree-install.stamp
        # Layering only applies on next boot; reboot once, then init units take over.
        ExecStartPost=/usr/bin/systemctl reboot
        TimeoutStartSec=900

        [Install]
        WantedBy=multi-user.target
