# 00-base-system — FCOS base layer: core user, SSH/journald/sysctl/zincati
# hardening drop-ins, optional static NetworkManager connection.
#
# Standalone Butane fragment. roles/butane_composer transpiles it to .ign and
# merges it with the other enabled modules via root.bu (ignition.config.merge).
variant: fcos
version: 1.5.0

passwd:
  users:
    - name: core
      groups:
        - wheel
      password_hash: {{ fcos_core_password_hash }}
      ssh_authorized_keys:
        - {{ fcos_ssh_public_key }}

storage:
  directories:
    - path: /etc/ssh/sshd_config.d
      mode: 0700
    - path: /etc/systemd/journald.conf.d
      mode: 0755
    - path: /etc/sysctl.d
      mode: 0755
    - path: /etc/zincati/config.d
      mode: 0755
{% if use_static_ip | bool %}
    - path: /etc/NetworkManager/system-connections
      mode: 0755
{% endif %}
  files:
    # ---- host-level hardening -------------------------------------------
    - path: /etc/ssh/sshd_config.d/00-hardening.conf
      mode: 0600
      overwrite: true
      contents:
        local: files/sshd-hardening.conf
    - path: /etc/systemd/journald.conf.d/50-hardening.conf
      mode: 0644
      overwrite: true
      contents:
        local: files/journald-hardening.conf
    - path: /etc/sysctl.d/90-kasm.conf
      mode: 0644
      overwrite: true
      contents:
        local: files/sysctl-kasm.conf
    - path: /etc/zincati/config.d/10-updates.toml
      mode: 0644
      overwrite: true
      contents:
        local: files/zincati-updates.toml
{% if use_static_ip | bool %}
    # Static addressing via a NetworkManager keyfile. Ignition writes it
    # root:root 0600 before NM starts, which NM accepts. Verify on first boot:
    #   nmcli -f NAME,DEVICE connection show
    - path: /etc/NetworkManager/system-connections/90-fcos-static.nmconnection
      mode: 0600
      overwrite: true
      contents:
        inline: |
          [connection]
          id=fcos-static-{{ fcos_interface }}
          uuid=3f8a1c2e-9b4d-4e7a-b6c5-2d1e0f9a8b7c
          type=ethernet
          interface-name={{ fcos_interface }}
          autoconnect=true
          autoconnect-priority=10

          [ethernet]

          [ipv4]
          method=manual
          address1={{ fcos_lan_ip }}/{{ fcos_lan_prefix }},{{ fcos_gateway }}
          dns={{ fcos_gateway }}
          route-metric=100

          [ipv6]
          method=disabled
{% endif %}
