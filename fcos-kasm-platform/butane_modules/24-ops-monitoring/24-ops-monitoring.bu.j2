# 24-ops-monitoring — Lynis daily security audit timer.
# lynis-init.service enables the timer after rpm-ostree layering.
variant: fcos
version: 1.5.0

storage:
  directories:
    - path: /var/log/lynis
      mode: 0755
    - path: /usr/local/sbin
      mode: 0755
  files:
    - path: /usr/local/sbin/lynis-init.sh
      mode: 0755
      overwrite: true
      contents:
        local: files/lynis-init.sh

systemd:
  units:
    - name: lynis-init.service
      enabled: true
      contents: |
        [Unit]
        Description=Lynis timer enable (post rpm-ostree layering)
        After=local-fs.target rpm-ostree-layer.service
        ConditionPathExists=/var/lib/rpm-ostree-install.stamp

        [Service]
        Type=oneshot
        RemainAfterExit=yes
        ExecStart=/usr/local/sbin/lynis-init.sh

        [Install]
        WantedBy=multi-user.target

    - name: lynis-daily.service
      contents: |
        [Unit]
        Description=Daily Lynis security audit (quick profile)
        After=local-fs.target

        [Service]
        Type=oneshot
        ExecStart=/usr/bin/lynis audit system --quick --no-colors --logfile /var/log/lynis/lynis.log
        ExecStartPost=/usr/bin/tar -czf /var/log/lynis/lynis-$(date +%%Y%%m%%d).tar.gz -C /var/log lynis 2>/dev/null || true
        Nice=19
        IOSchedulingClass=idle

    - name: lynis-daily.timer
      contents: |
        [Unit]
        Description=Run lynis-daily daily at 05:45

        [Timer]
        OnCalendar=*-*-* 05:45:00
        Persistent=true

        [Install]
        WantedBy=timers.target
