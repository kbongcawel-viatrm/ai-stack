<?xml version='1.0' encoding='utf-8'?>
<!-- Rendered by qemu_provisioner. KVM + virtio NIC on {{ fcos_network_bridge }}
     gives the guest a predictable ens2 interface (libvirt slot 0x02). -->
<domain type='kvm' xmlns:qemu='http://libvirt.org/schemas/domain/qemu/1.0'>
  <name>{{ fcos_vm_name }}</name>
  <memory unit='MiB'>{{ fcos_vm_memory_mb }}</memory>
  <vcpu>{{ fcos_vm_vcpus }}</vcpu>
  <os>
    <type arch='x86_64' machine='q35'>hvm</type>
    <boot dev='hd'/>
  </os>
  <features>
    <acpi/>
    <apic/>
  </features>
  <cpu mode='host-passthrough'>
    <topology sockets='1' cores='{{ fcos_vm_vcpus }}' threads='1'/>
  </cpu>
  <clock offset='utc'/>
  <on_poweroff>destroy</on_poweroff>
  <on_reboot>restart</on_reboot>
  <on_crash>destroy</on_crash>
  <devices>
    <emulator>/usr/libexec/qemu-kvm</emulator>
    <disk type='file' device='disk'>
      <driver name='qemu' type='qcow2'/>
      <source file='{{ fcos_overlay_path }}'/>
      <target dev='vda' bus='virtio'/>
    </disk>
    <interface type='bridge'>
      <source bridge='{{ fcos_network_bridge }}'/>
      <model type='virtio'/>
{% if fcos_vm_mac | length > 0 %}
      <mac address='{{ fcos_vm_mac }}'/>
{% endif %}
    </interface>
    <serial type='pty'>
      <target port='0'/>
    </serial>
    <console type='pty'>
      <target port='0'/>
    </console>
{% if fcos_first_boot | bool %}
    <!-- Ignition via fw_cfg: only valid on first boot of a fresh overlay. -->
    <qemu:commandline>
      <qemu:arg value='-fw_cfg'/>
      <qemu:arg value='name=opt/com.coreos/config,file={{ fcos_ignition_path }}'/>
    </qemu:commandline>
{% endif %}
  </devices>
</domain>
