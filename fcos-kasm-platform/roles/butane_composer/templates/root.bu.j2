# root.bu — merge manifest. Each enabled module is transpiled to a standalone
# .ign fragment under build/fragments/, then merged here via
# ignition.config.merge. butane inlines each fragment at transpile time.
variant: fcos
version: 1.5.0

ignition:
  config:
    merge:
{% for module in enabled_bu_modules %}
      - local: fragments/{{ module }}.ign
{% endfor %}
