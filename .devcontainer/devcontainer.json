{
  "name": "AI Stack + PHP Patch Automation",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/terraform:1": {
      "version": "1.9"
    },
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "postCreateCommand": "bash php-patch-automation/scripts/bootstrap-dev.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "charliermarsh.ruff",
        "hashicorp.terraform",
        "GitHub.vscode-github-actions",
        "redhat.vscode-yaml"
      ]
    }
  }
}
